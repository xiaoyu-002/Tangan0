        <p v-if="selectedItem" class="insight-copy">{{ selectedItem.description }}</p>

        <div class="video-section-head">
          <h3>证据视频</h3>
          <span v-if="loadingVideos">加载中...</span>
          <span v-else>{{ videos.length }} / {{ total.toLocaleString() }}</span>
